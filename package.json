{
  "name": "igms_gascockpit",
  "version": "1.0.0",
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4.1.1",
    "@sap-cloud-sdk/http-client": "^4.1.1",
    "@sap-cloud-sdk/resilience": "^4.1.1",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "hybrid": "NODE_OPTIONS=\"$NODE_OPTIONS --disable-warning=DEP0190\" cds watch --profile hybrid",
    "watch-igms_gasflow": "cds watch --open com.ingenx.igmsgasflow/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy igms_gascockpit --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "cds": {
    "requires": {
      "GMSCONFIRMNOM_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/GMSCONFIRMNOM_SRV",
        "[production]": {
          "credentials": {
            "destination": "IGMS_GAIL_DEV",
            "path": "/sap/opu/odata/gms/CONFIRMNOM_SRV",
            "requestTimeout": 1200000
          }
        },
        "[development]": {
          "credentials": {
            "destination": "SandboxPO",
            "path": "/sap/opu/odata/gms/CONFIRMNOM_SRV",
            "requestTimeout": 1200000
          }
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "GMSCONTRACT_MGMT_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/GMSCONTRACT_MGMT_SRV",
