{
  "_version": "1.89.0",
  "sap.app": {
    "id": "com.ingenx.igmsgasflow",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "b6d56880-b9d8-433e-ac6e-f83f1f39618f"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/gas-ops/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "igms_gas_operations-igms_gas_operations": {
          "semanticObject": "igms_gas_operations",
          "action": "igms_gas_operations",
          "title": "{{igms_gas_operations-igms_gas_operations.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.export": {},
        "sap.ui.mdc": {
          "lazy": false
        },
        "sap.ui.fl": {},
        "sap.ui.table": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.ingenx.igmsgasflow.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        },
        {
          "uri": "css/BalancingScheduling.css"
        },
        {
          "uri": "css/AllocationNTicketing.css"
        },
        {
          "uri": "css/ConfirmScheduleNomination.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.ingenx.igmsgasflow.view",
        "async": true,
        "viewPath": "com.ingenx.igmsgasflow.view"
      },
      "routes": [
        {
          "name": "RouteHome",
          "pattern": ":?query:",
          "target": [
            "TargetHome"
          ]
        },
        {
          "name": "RouteConfirmScheduleNomination",
          "pattern": "confirmScheduleNomination",
          "target": [
            "TargetConfirmScheduleNomination"
          ]
        },
        {
          "name": "RouteallocationNTicketing",
          "pattern": "allocationNTicketing",
          "target": [
            "TargetallocationNTicketing"
          ]
        },
        {
          "name": "RouteTicketingRunLogs",
          "pattern": "ticketingRunLogs/{jobId}",
          "target": [
            "TargetTicketingRunLogs"
          ]
        },
        {
          "name": "RouteTicketLogs",
          "pattern": "ticketLogs/:from:/:gasday:",
          "target": [
            "TargetTicketLogs"
          ]
        },
        {
          "name": "RouteDateWiseTicketLogs",
          "pattern": "dateWiseTicketLogs/{logId}/:from:",
          "target": [
            "TargetDateWiseTicketLogs"
          ]
        }
      ],
      "targets": {
        "TargetHome": {
          "id": "Home",
          "name": "Home"
        },
        "TargetConfirmScheduleNomination": {
          "id": "confirmScheduleNomination",
          "name": "confirmScheduleNomination"
        },
        "TargetallocationNTicketing": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "allocationNTicketing",
          "viewName": "allocationNTicketing"
        },
        "TargetTicketingRunLogs": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "ticketingRunLogs",
          "viewName": "ticketingRunLogs"
        },
        "TargetTicketLogs": {
          "id": "ticketLogs",
          "name": "ticketLogs"
        },
        "TargetDateWiseTicketLogs": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "dateWiseTicketLogs",
          "viewName": "dateWiseTicketLogs"
        }
      }
    },
    "rootView": {
      "viewName": "com.ingenx.igmsgasflow.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    },
    "resourceRoots": {
      "com.ingenx.igmsgasflow": "./"
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "igms_gas_operations"
  }
}
