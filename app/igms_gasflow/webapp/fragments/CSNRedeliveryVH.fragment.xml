<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="IdCSNRedeliveryVHDlg"
        contentWidth="44rem"
        contentHeight="30rem"
        draggable="true"
        resizable="true">

        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Redelivery Point"/>
                </contentLeft>
                <contentMiddle>
                    <SearchField id="IdCSNRedeliveryVHSearch"
                        width="16rem"
                        search=".onRedeliveryVHSearch"
                        liveChange=".onRedeliveryVHSearch"/>
                </contentMiddle>
                <!-- <contentRight>
                    <Button text="Select All"   type="Transparent" press=".onRedeliverySelectAll"/>
                    <Button text="Deselect All" type="Transparent" press=".onRedeliveryDeselectAll"/>
                </contentRight> -->
            </Bar>
        </customHeader>

        <content>
            <Table id="IdCSNRedeliveryVHTable"
                mode="MultiSelect"
                growing="true"
                growingScrollToLoad="true"
                updateFinished=".onRedeliveryVHUpdateFinished"
                selectionChange=".onRedeliveryVHSelectionChange">
                <columns>
                    <Column width="8rem"><header><Label text="Location ID"/></header></Column>
                    <Column><header><Label text="Location Name"/></header></Column>
                </columns>
                <items>
                    <ColumnListItem type="Inactive">
                        <cells>
                            <Text text="{Locid}"/>
                            <Text text="{Locnam}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <beginButton>
            <Button text="OK"     type="Emphasized" press=".onRedeliveryVHConfirm"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onRedeliveryVHCancel"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
