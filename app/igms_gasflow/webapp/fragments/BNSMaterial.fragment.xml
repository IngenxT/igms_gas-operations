<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog
        id="IdBNSMaterial"
        noDataText="No Material Found"
        title="Select Material"
        multiSelect="true"
        growing="true"
        growingThreshold="100"
        rememberSelections="false"
        liveChange="onLiveSearchMaterial"
        confirm="onConfirmMaterial"
        cancel="pressToClearSearch"
        draggable="true"
        items="{
            path: '/materiallMaster',
            parameters: { $$ownRequest: true }
        }">
        <StandardListItem
            title="{Material}"
            description="{Material_Text}"
            iconDensityAware="false"
            iconInset="false"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>