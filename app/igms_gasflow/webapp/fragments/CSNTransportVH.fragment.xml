<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="IdCSNTransportVHDlg"
        contentWidth="38rem"
        contentHeight="30rem"
        draggable="true"
        resizable="true">

        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Transport System"/>
                </contentLeft>
                <contentMiddle>
                    <SearchField id="IdCSNTransportVHSearch"
                        width="14rem"
                        search=".onTransportVHSearch"
                        liveChange=".onTransportVHSearch"/>
                </contentMiddle>
                <!-- <contentRight>
                    <Button text="Select All"   type="Transparent" press=".onTransportSelectAll"/>
                    <Button text="Deselect All" type="Transparent" press=".onTransportDeselectAll"/>
                </contentRight> -->
            </Bar>
        </customHeader>

        <content>
            <Table id="IdCSNTransportVHTable"
                mode="MultiSelect"
                growing="true"
                growingScrollToLoad="true"
                updateFinished=".onTransportVHUpdateFinished"
                selectionChange=".onTransportVHSelectionChange">
                <columns>
                    <Column width="10rem"><header><Label text="Transport ID"/></header></Column>
                    <Column><header><Label text="Transport Name"/></header></Column>
                </columns>
                <items>
                    <ColumnListItem type="Inactive">
                        <cells>
                            <Text text="{Tsyst}"/>
                            <Text text="{Tsnam}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <beginButton>
            <Button text="OK"     type="Emphasized" press=".onTransportVHConfirm"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onTransportVHCancel"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
