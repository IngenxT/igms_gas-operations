<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <!-- Column-visibility settings for IdTcktLogsMainTable — items bound to the
         controller's own columnSettings JSON model (id/text/visible per column),
         built fresh from the table's actual columns each time this opens. Toggling a
         row here both hides/shows the real table column and persists the choice
         (see the controller's own onColumnVisibilitySelectionChange). -->
    <Dialog
        id="IdTcktLogsColumnSettingsDialog"
        title="{i18n>dlgTitleColumnSettings}"
        contentWidth="20rem"
        contentHeight="24rem">
        <content>
            <List
                id="IdTcktLogsColumnSettingsList"
                mode="MultiSelect"
                items="{columnSettings>/columns}"
                selectionChange="onColumnVisibilitySelectionChange">
                <StandardListItem title="{columnSettings>text}" selected="{columnSettings>visible}" />
            </List>
        </content>
        <beginButton>
            <Button text="{i18n>btnResetDefault}" press="onResetColumnSettings" />
        </beginButton>
        <endButton>
            <Button text="{i18n>btnClose}" press="onCloseColumnSettings" />
        </endButton>
    </Dialog>

</core:FragmentDefinition>
