<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="IdCSNInterconnectVHDlg"
        contentWidth="44rem"
        contentHeight="30rem"
        draggable="true"
        resizable="true">

        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Interconnect Point"/>
                </contentLeft>
                <contentMiddle>
                    <SearchField id="IdCSNInterconnectVHSearch"
                        width="16rem"
                        search=".onInterconnectVHSearch"
                        liveChange=".onInterconnectVHSearch"/>
                </contentMiddle>
                <!-- <contentRight>
                    <Button text="Select All"   type="Transparent" press=".onInterconnectSelectAll"/>
                    <Button text="Deselect All" type="Transparent" press=".onInterconnectDeselectAll"/>
                </contentRight> -->
            </Bar>
        </customHeader>

        <content>
            <Table id="IdCSNInterconnectVHTable"
                mode="MultiSelect"
                growing="false"
                updateFinished=".onInterconnectVHUpdateFinished"
                selectionChange=".onInterconnectVHSelectionChange">
                <columns>
                    <Column width="8rem"><header><Label text="Location ID"/></header></Column>
                    <Column><header><Label text="Location Name"/></header></Column>
                    <Column width="8rem"><header><Label text="Transport"/></header></Column>
                </columns>
                <items>
                    <ColumnListItem type="Inactive">
                        <cells>
                            <Text text="{Locid}"/>
                            <Text text="{Locnam}"/>
                            <Text text="{Tsyst}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <beginButton>
            <Button text="OK"     type="Emphasized" press=".onInterconnectVHConfirm"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onInterconnectVHCancel"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
