<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="IdCSNDeliveryVHDlg"
        contentWidth="44rem"
        contentHeight="30rem"
        draggable="true"
        resizable="true">

        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Delivery Point"/>
                </contentLeft>
                <contentMiddle>
                    <SearchField id="IdCSNDeliveryVHSearch"
                        width="16rem"
                        search=".onDeliveryVHSearch"
                        liveChange=".onDeliveryVHSearch"/>
                </contentMiddle>
                <!-- <contentRight>
                    <Button text="Select All"   type="Transparent" press=".onDeliverySelectAll"/>
                    <Button text="Deselect All" type="Transparent" press=".onDeliveryDeselectAll"/>
                </contentRight> -->
            </Bar>
        </customHeader>

        <content>
            <Table id="IdCSNDeliveryVHTable"
                mode="MultiSelect"
                growing="true"
                growingScrollToLoad="true"
                updateFinished=".onDeliveryVHUpdateFinished"
                selectionChange=".onDeliveryVHSelectionChange">
                <columns>
                    <Column width="8rem"><header><Label text="Location ID"/></header></Column>
                    <Column><header><Label text="Location Name"/></header></Column>
                    <Column width="8rem"><header><Label text="Transport"/></header></Column>
                </columns>
                <items>
                    <ColumnListItem type="Inactive">
                        <cells>
                            <Text text="{Locid}"/>
                            <Text text="{Locnam}"/>
                            <Text text="{Tsyst}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <beginButton>
            <Button text="OK"     type="Emphasized" press=".onDeliveryVHConfirm"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onDeliveryVHCancel"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
