     "doc": "Paramter ID when tokenType is ServiceParameter"
    },
    "serviceParamName": {
     "type": "cds.String",
     "length": 100,
     "@Common.Label": "Service Parameter Name",
     "doc": "Display name when tokenType is ServiceParameter"
    },
    "operator": {
     "type": "cds.String",
     "length": 5,
     "@Common.Label": "Operator",
     "doc": "Arithmetic operator when tokenType is Operator (+, -, *, /, %)",
     "@Validation.AllowedValues": [
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Add",
       "Value": "+"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Subtract",
       "Value": "-"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Multiply",
       "Value": "*"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Divide",
       "Value": "/"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Modulo",
       "Value": "%"
      }
     ]
    },
    "tokenValue": {
     "type": "cds.String",
     "length": 200,
     "@Common.Label": "Token Value",
     "doc": "String value when tokenType is Value"
    },
    "condition": {
     "type": "cds.Association",
     "target": "igmsConfigMetaData.RuleConditions",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "condition",
        "ID"
       ]
      },
      "=",
      {
       "ref": [
        "condition_ID"
       ]
      }
     ]
    },
    "serviceParameter": {
     "type": "cds.Association",
     "target": "igmsConfigMetaData.ServiceParameters",
