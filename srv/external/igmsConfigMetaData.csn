     "type": "cds.Date",
     "@Common.Label": "Valid From"
    },
    "validTo": {
     "type": "cds.Date",
     "@Common.Label": "Valid To"
    },
    "actionType": {
     "type": "cds.String",
     "length": 20,
     "@Common.Label": "Action Type",
     "@Common.FieldControl": {
      "#": "Mandatory"
     },
     "doc": "Action to take when rule conditions are met",
