  "igmsConfigMetaData.ReconRules": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "createdAt": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Immutable": true,
     "@Core.Computed": true,
     "@Common.Label": "Created On"
    },
    "createdBy": {
     "type": "cds.String",
     "length": 255,
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Immutable": true,
     "@Core.Computed": true,
     "doc": "User's unique ID",
     "@Common.Label": "Created By"
    },
    "modifiedAt": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Computed": true,
     "@Common.Label": "Changed On"
    },
    "modifiedBy": {
     "type": "cds.String",
     "length": 255,
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Computed": true,
     "doc": "User's unique ID",
     "@Common.Label": "Changed By"
    },
    "ruleId": {
     "key": true,
     "type": "cds.String",
     "length": 10,
     "notNull": true,
     "@Common.Label": "Rule ID",
     "doc": "Unique rule identifier, auto-generated (RECON-001, RECON-002...)"
    },
    "description": {
     "type": "cds.String",
     "length": 50,
     "@Common.Label": "Description",
     "doc": "Short description of the reconciliation rule (max 50 chars)"
    },
    "priority": {
     "type": "cds.Integer",
     "default": {
      "val": 999
     },
     "@Common.Label": "Priority",
     "doc": "Execution priority — lower number runs first (1 = highest)"
    },
    "leadingVol": {
     "type": "cds.String",
     "length": 10,
     "@Common.Label": "Leading Volume",
     "doc": "Which side drives the transfer quantity — SALES or PURCHASE"
    },
    "status": {
     "type": "cds.String",
     "length": 10,
     "default": {
      "val": "Draft"
     },
     "@Common.Label": "Status",
     "doc": "Lifecycle status of the rule — Draft, Active, or Inactive"
    },
    "validFrom": {
     "type": "cds.Date",
     "@Common.Label": "Valid From",
     "doc": "Date from which this rule is effective"
    },
    "validTo": {
     "type": "cds.Date",
     "@Common.Label": "Valid To",
     "doc": "Date until which this rule is effective"
    },
    "budatFrom": {
     "type": "cds.Date",
     "@Common.Label": "Posting Date From",
     "doc": "Optional BUDAT range start for document date filtering"
    },
    "budatTo": {
     "type": "cds.Date",
     "@Common.Label": "Posting Date To",
     "doc": "Optional BUDAT range end for document date filtering"
    },
    "precedingRule": {
     "type": "cds.String",
     "length": 10,
     "@Common.Label": "Preceding Rule",
     "doc": "Rule that must execute successfully before this rule runs"
    },
    "followOnRule": {
     "type": "cds.String",
     "length": 10,
     "@Common.Label": "Follow-on Rule",
     "doc": "Rule that auto-triggers after this rule completes successfully"
    },
    "purchaseSide": {
     "type": "cds.Composition",
     "target": "igmsConfigMetaData.ReconPurchaseSide",
     "cardinality": {
      "max": "*"
     },
     "on": [
      {
       "ref": [
        "purchaseSide",
        "rule"
       ]
      },
      "=",
      {
       "ref": [
        "$self"
       ]
      }
     ],
     "@Common.Label": "Purchase Side",
     "doc": "Purchase material and plant mapping rows for this rule"
    },
    "salesSide": {
     "type": "cds.Composition",
     "target": "igmsConfigMetaData.ReconSalesSide",
     "cardinality": {
      "max": "*"
     },
     "on": [
      {
       "ref": [
        "salesSide",
        "rule"
       ]
      },
      "=",
      {
       "ref": [
        "$self"
       ]
      }
     ],
     "@Common.Label": "Sales Side",
     "doc": "Sales material and plant mapping rows for this rule"
    }
   },
   "@Common.Label": "Reconciliation Rules",
   "doc": "Master configuration table for iGMS stock reconciliation rules"
  },
