  "igmsConfigMetaData.ReconPostingLog": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "createdAt": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Immutable": true,
     "@Core.Computed": true,
     "@Common.Label": "Created On"
    },
    "createdBy": {
     "type": "cds.String",
     "length": 255,
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Immutable": true,
     "@Core.Computed": true,
     "doc": "User's unique ID",
     "@Common.Label": "Created By"
    },
    "modifiedAt": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Computed": true,
     "@Common.Label": "Changed On"
    },
    "modifiedBy": {
     "type": "cds.String",
     "length": 255,
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Computed": true,
     "doc": "User's unique ID",
     "@Common.Label": "Changed By"
    },
    "ID": {
     "key": true,
     "type": "cds.UUID",
     "notNull": true,
     "@Common.Label": "ID",
     "doc": "Auto-generated unique row identifier",
     "@Core.ComputedDefaultValue": true
    },
    "runId": {
     "type": "cds.String",
     "length": 20,
     "@Common.Label": "Run ID",
     "doc": "Groups postings originating from one execution run (e.g. a 309 and its shortfall-driven 301)"
    },
    "ruleId": {
     "type": "cds.String",
     "length": 10,
     "@Common.Label": "Rule ID",
     "doc": "Reconciliation rule this posting was executed for"
    },
    "precedingRule": {
     "type": "cds.String",
     "length": 10,
     "@Common.Label": "Preceding Rule",
     "doc": "Preceding rule, snapshotted from the rule master at execution time"
    },
    "followOnRule": {
     "type": "cds.String",
     "length": 10,
     "@Common.Label": "Follow-on Rule",
     "doc": "Follow-on rule, snapshotted from the rule master at execution time"
    },
    "leadingVol": {
     "type": "cds.String",
     "length": 10,
     "@Common.Label": "Leading Volume",
     "doc": "Which side drove the transfer quantity — SALES or PURCHASE, snapshotted at execution time"
    },
    "execDate": {
     "type": "cds.Date",
     "@Common.Label": "Execution Date",
     "doc": "Date the reconciliation was executed on this screen"
    },
    "budatFrom": {
     "type": "cds.Date",
     "@Common.Label": "Posting Date From",
     "doc": "BUDAT range start used to pull MSEG-sourced quantities for this run"
    },
    "budatTo": {
     "type": "cds.Date",
     "@Common.Label": "Posting Date To",
     "doc": "BUDAT range end used to pull MSEG-sourced quantities for this run"
    },
    "postingDate": {
     "type": "cds.Date",
     "@Common.Label": "Posting Date",
     "doc": "Posting date sent to the BAPI (I_BUDAT)"
    },
    "docDate": {
     "type": "cds.Date",
     "@Common.Label": "Document Date",
     "doc": "Document date sent to the BAPI (I_DOC_DATE)"
    },
    "movementType": {
     "type": "cds.String",
     "length": 3,
     "@Common.Label": "Movement Type",
     "doc": "Movement type posted — 309 (same-plant transfer) or 301 (plant-to-plant transfer)"
    },
    "materialDocument": {
     "type": "cds.String",
     "length": 10,
     "@Common.Label": "Material Document",
     "doc": "SAP material document number returned by BAPI_GOODSMVT_CREATE"
    },
    "materialDocumentYear": {
     "type": "cds.String",
     "length": 4,
     "@Common.Label": "Material Document Year",
     "doc": "Fiscal year of the material document returned by BAPI_GOODSMVT_CREATE"
    },
    "salesTotal": {
     "type": "cds.Decimal",
     "precision": 15,
     "scale": 3,
     "@Common.Label": "Sales Total",
     "doc": "Total sales-side quantity for the rule at execution time"
    },
    "purchaseTotal": {
     "type": "cds.Decimal",
     "precision": 15,
     "scale": 3,
     "@Common.Label": "Purchase Total",
     "doc": "Total purchase-side quantity for the rule at execution time"
    },
    "difference": {
     "type": "cds.Decimal",
     "precision": 15,
     "scale": 3,
     "@Common.Label": "Difference",
     "doc": "Sales/Purchase quantity difference this posting covers"
    },
    "uom": {
     "type": "cds.String",
     "length": 3,
     "@Common.Label": "UOM",
     "doc": "Unit of measure for the totals and difference"
    },
    "status": {
     "type": "cds.String",
     "length": 10,
     "@Common.Label": "Status",
     "doc": "Outcome of the posting attempt — Posted or Failed"
    },
    "bapiMessage": {
     "type": "cds.String",
     "length": 500,
     "@Common.Label": "BAPI Message",
     "doc": "Return message text from BAPI_GOODSMVT_CREATE (to_ReturnMsg)"
    },
    "postedBy": {
     "type": "cds.String",
     "length": 100,
     "@Common.Label": "Posted By",
     "doc": "User who confirmed and posted this run"
    },
    "rule": {
     "type": "cds.Association",
     "target": "igmsConfigMetaData.ReconRules",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "rule",
        "ruleId"
       ]
      },
      "=",
      {
       "ref": [
        "ruleId"
       ]
      }
     ]
    },
    "items": {
     "type": "cds.Composition",
     "target": "igmsConfigMetaData.ReconPostingLogItem",
     "cardinality": {
      "max": "*"
     },
     "on": [
      {
       "ref": [
        "items",
        "log"
       ]
      },
      "=",
      {
       "ref": [
        "$self"
       ]
      }
     ],
     "@Common.Label": "Posting Items",
     "doc": "Line items belonging to this posting"
    }
   },
   "doc": "Audit log of every 301/309 posting attempt made from the Reconciliation Execution screen",
   "@Common.Label": "Reconciliation Posting Log"
  },
