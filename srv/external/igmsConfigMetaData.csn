     "key": true,
     "type": "cds.UUID",
     "notNull": true,
     "@Common.Label": "ID",
     "doc": "Auto-generated unique row identifier",
     "@Core.ComputedDefaultValue": true
    },
    "log_ID": {
     "type": "cds.UUID",
     "@Common.Label": "Posting Log",
     "doc": "Parent posting log this line belongs to"
    },
    "lineNo": {
     "type": "cds.Integer",
     "@Common.Label": "Line Number",
     "doc": "Sequence number of this line within the posting"
    },
    "matnr": {
     "type": "cds.String",
     "length": 18,
     "@Common.Label": "Material",
     "doc": "SAP Material Number (MATNR)"
    },
    "charg": {
     "type": "cds.String",
     "length": 10,
     "@Common.Label": "Batch Number",
     "doc": "Batch number (XCHARG)"
    },
    "fromWerks": {
     "type": "cds.String",
     "length": 4,
     "@Common.Label": "From Plant",
     "doc": "Issuing plant (WERKS)"
    },
    "toWerks": {
     "type": "cds.String",
     "length": 4,
     "@Common.Label": "To Plant",
     "doc": "Receiving plant (WERKS)"
    },
    "fromStgeLoc": {
     "type": "cds.String",
     "length": 4,
     "@Common.Label": "From Storage Location",
     "doc": "Issuing storage location (LGORT)"
    },
    "toStgeLoc": {
     "type": "cds.String",
     "length": 4,
     "@Common.Label": "To Storage Location",
     "doc": "Receiving storage location (LGORT)"
    },
    "qty": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "@Common.Label": "Quantity",
     "doc": "Quantity posted on this line"
    },
    "uom": {
     "type": "cds.String",
     "length": 3,
     "@Common.Label": "UOM",
     "doc": "Unit of measure for the quantity"
    },
    "lineStatus": {
     "type": "cds.String",
     "length": 10,
     "@Common.Label": "Line Status",
     "doc": "Outcome of this line item within the posting"
    },
    "log": {
     "type": "cds.Association",
     "target": "igmsConfigMetaData.ReconPostingLog",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "log",
        "ID"
       ]
      },
      "=",
      {
       "ref": [
        "log_ID"
       ]
      }
     ],
     "@Common.Label": "Posting Log",
     "doc": "Parent posting log this line belongs to"
    }
   },
   "doc": "Line items for a reconciliation posting",
   "@Common.Label": "Reconciliation Posting Log Item"
  },
