    },
    "tokenType": {
     "type": "cds.String",
     "length": 20,
     "@Common.Label": "Token Type",
     "@Common.FieldControl": {
      "#": "Mandatory"
     },
     "doc": "Type of formula token: ServiceParameter, Operator, or Value",
     "@Validation.AllowedValues": [
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "ServiceParameter",
       "Value": "ServiceParameter"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Operator",
       "Value": "Operator"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Value",
