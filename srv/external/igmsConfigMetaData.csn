       "@Core.SymbolicName": "Warning",
       "Value": "Warning"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Information",
       "Value": "Information"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Allow",
       "Value": "Allow"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Block",
       "Value": "Block"
      }
     ]
    },
    "messageToShow": {
     "type": "cds.String",
     "length": 1000,
     "@Common.Label": "Message to Show",
     "doc": "Message displayed to user when rule triggers"
    },
    "triggerWorkflow": {
     "type": "cds.Boolean",
     "default": {
      "val": false
     },
     "@Common.Label": "Trigger Workflow",
     "doc": "Whether to trigger a workflow when rule conditions are met"
    },
    "sendEmail": {
     "type": "cds.Boolean",
     "default": {
      "val": false
     },
     "@Common.Label": "Send Email",
     "doc": "Whether to send an email notification when rule triggers"
    },
    "areaOfInterest": {
     "type": "cds.Association",
     "target": "igmsConfigMetaData.AreaOfInterest",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "areaOfInterest",
        "ruleAreaCode"
       ]
      },
      "=",
      {
       "ref": [
        "areaOfInterest_ruleAreaCode"
       ]
      }
     ]
    },
    "conditions": {
     "type": "cds.Composition",
     "target": "igmsConfigMetaData.RuleConditions",
     "cardinality": {
      "max": "*"
     },
     "on": [
      {
       "ref": [
        "conditions",
        "businessRule"
       ]
      },
      "=",
      {
       "ref": [
        "$self"
       ]
      }
     ]
    }
   },
   "@Common.Label": "Business Rules",
   "doc": "Business Rule Master Data with complete rule definitions and configurations"
  },
