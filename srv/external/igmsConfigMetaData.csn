     "type": "cds.Composition",
     "target": "igmsConfigMetaData.ScreenMaster",
     "cardinality": {
      "max": "*"
     },
     "on": [
      {
       "ref": [
        "screens",
        "group"
       ]
      },
      "=",
      {
       "ref": [
        "$self"
       ]
      }
     ]
    }
   },
