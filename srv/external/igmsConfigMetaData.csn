  "igmsConfigMetaData.ServiceParameters": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "createdAt": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Immutable": true,
     "@Core.Computed": true,
     "@Common.Label": "Created On"
    },
    "createdBy": {
     "type": "cds.String",
     "length": 255,
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Immutable": true,
     "@Core.Computed": true,
     "doc": "User's unique ID",
     "@Common.Label": "Created By"
    },
    "modifiedAt": {
     "type": "cds.Timestamp",
     "@odata.Precision": 7,
     "@odata.Type": "Edm.DateTimeOffset",
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Computed": true,
     "@Common.Label": "Changed On"
    },
    "modifiedBy": {
     "type": "cds.String",
     "length": 255,
     "@UI.HiddenFilter": true,
     "@UI.ExcludeFromNavigationContext": true,
     "@Core.Computed": true,
     "doc": "User's unique ID",
     "@Common.Label": "Changed By"
    },
    "serviceParameter": {
     "type": "cds.String",
     "length": 100,
     "notNull": true,
     "@Common.Label": "Service Parameter",
     "@Common.FieldControl": {
      "#": "Mandatory"
     },
     "doc": "Unique parameter name (immutable after creation)",
     "@Validation.Pattern": "^[A-Za-z0-9_+-]+(?:[ /][A-Za-z0-9_+-]+)*(?<! )$"
    },
    "parameterID": {
     "key": true,
     "type": "cds.String",
     "length": 20,
     "notNull": true,
     "@PersonalData.FieldSemantics": "DataSubjectID",
     "@Common.Label": "Parameter ID",
     "doc": "Auto-generated unique identifier with SSP/DSP prefix",
     "@Core.Computed": true,
     "@Validation.Pattern": "^(SSP|DSP)[0-9]{3}$"
    },
    "serviceParameterLabel": {
     "type": "cds.String",
     "length": 100,
     "@Common.Label": "Parameter Label",
     "doc": "User-friendly display name for the parameter"
    },
    "serviceParameterType": {
     "type": "cds.String",
     "notNull": true,
     "@Common.Label": "Parameter Type",
     "@Common.FieldControl": {
      "#": "Mandatory"
     },
     "doc": "Data type classification",
     "@Validation.AllowedValues": [
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "String",
       "Value": "String"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Boolean",
       "Value": "Boolean"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Decimal",
       "Value": "Decimal"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Integer",
       "Value": "Integer"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "List",
       "Value": "List"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Date",
       "Value": "Date"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Datetime",
       "Value": "Datetime"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "Quantity",
       "Value": "Quantity"
      }
     ]
    },
    "serviceParameterLength": {
     "type": "cds.Integer",
     "@Common.Label": "Parameter Length",
     "doc": "Maximum character length (applicable for STRING types)",
     "@Validation.Minimum": 1,
     "@Validation.Maximum": 50
    },
    "listValues": {
     "items": {
      "type": "cds.String"
     },
     "@Common.Label": "List Values",
     "doc": "Comma-separated predefined values for LIST type parameters"
    },
    "allocationLevel": {
     "type": "cds.Integer",
     "@Common.Label": "Allocation Level",
     "doc": "Rank for Allocation",
     "@Validation.Minimum": 1,
     "@Validation.Maximum": 999
    },
    "parameterRelevancy": {
     "type": "cds.String",
     "@Common.Label": "Parameter Relevancy",
     "doc": "Business functional area where parameter applies",
     "@Validation.AllowedValues": [
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "ORG_DETAILS",
       "Value": "OrgDetails"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "CAPACITY_DETAILS",
       "Value": "CapacityDetails"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "SERVICE_CATALOG",
       "Value": "ServiceCatalog"
      }
     ]
    },
    "allocFormulaRelevant": {
     "type": "cds.Boolean",
     "default": {
      "val": false
     },
     "@Common.Label": "Formula Relevant",
     "doc": "Include in allocation formula calculations"
    },
    "groupRelevant": {
     "type": "cds.Boolean",
     "default": {
      "val": false
     },
     "@Common.Label": "Group Relevant",
     "doc": "Include in allocation formula calculations"
    },
    "changeHistory": {
     "type": "cds.Boolean",
     "default": {
      "val": false
     },
     "@Common.Label": "Change History",
     "doc": "Indicate whether user wants to save the history of the selected parameter data."
    },
    "flag": {
     "type": "cds.String",
     "notNull": true,
     "@Common.Label": "Parameter Source",
     "@Common.FieldControl": {
      "#": "Mandatory"
     },
     "doc": "Control mechanism: Product Owner (STATIC) or End User (DYNAMIC)",
     "@Validation.AllowedValues": [
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "STATIC",
       "Value": "STATIC"
      },
      {
       "$Type": "Validation.AllowedValue",
       "@Core.SymbolicName": "DYNAMIC",
       "Value": "DYNAMIC"
      }
     ]
    },
    "isActive": {
     "type": "cds.Boolean",
     "default": {
      "val": true
     },
     "@Common.Label": "Active",
     "doc": "Parameter status (Active=true, Deleted=false)",
     "@Core.Computed": true
    }
   },
   "@Common.Label": "Service Parameters",
   "doc": "Defines parameter master data used in shipper configurations"
  },
