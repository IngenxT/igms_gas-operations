     "key": true,
     "type": "cds.UUID",
     "notNull": true,
     "@Core.ComputedDefaultValue": true
    },
    "workflow_ID": {
     "type": "cds.UUID"
    },
    "nodeId": {
     "type": "cds.String",
     "length": 50,
     "notNull": true
    },
    "level": {
     "type": "cds.Integer",
     "default": {
      "val": 0
     }
    },
    "parentId": {
     "type": "cds.String",
     "length": 50
    },
    "workflow": {
     "type": "cds.Association",
     "target": "igmsConfigMetaData.Workflow",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "workflow",
        "ID"
       ]
      },
      "=",
      {
       "ref": [
        "workflow_ID"
       ]
      }
     ]
    },
    "actions": {
     "type": "cds.Composition",
     "target": "igmsConfigMetaData.WorkflowNodeAction",
     "cardinality": {
      "max": "*"
     },
     "on": [
      {
       "ref": [
        "actions",
        "node"
       ]
      },
      "=",
      {
       "ref": [
        "$self"
       ]
      }
     ]
    }
   }
  },
